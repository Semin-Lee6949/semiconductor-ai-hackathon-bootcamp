[Unit]
Description=Local Ollama for Virtual Fab Evidence Mentor
After=network-online.target

[Service]
Type=simple
ExecStart=/home/waterfirst/.local/ollama/bin/ollama serve
Restart=always
RestartSec=3
Environment=OLLAMA_HOST=127.0.0.1:11434
Environment=OLLAMA_MODELS=/home/waterfirst/.ollama/models
Environment=OLLAMA_KEEP_ALIVE=10m
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
